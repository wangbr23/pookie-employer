# PostgreSQL database connection
# Copy this file to .env and fill in values.
# For local Docker PostgreSQL (default credentials):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pookie_employer_dev

# Backend configuration
# SECRET_KEY for JWT signing or other cryptographic needs; generate a strong secret.
SECRET_KEY=your-secret-key-here

# Frontend configuration (optional, for CORS)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000/api
BACKEND_API_URL=http://localhost:8000/api

# AI provider (optional, for later tasks)
AI_PROVIDER=openai
AI_API_KEY=sk-your-api-key-here

# Environment mode
NODE_ENV=development
PYTHON_ENV=development